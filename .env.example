# banknifty-forensics-omega — non-secret environment template (FILE-005, NFR-05)
# Copy to .env if you want to override defaults. NEVER put broker tokens or secrets here:
# bnf removes UPSTOX_RO_TOKEN and every *TOKEN* / *SECRET* variable from its environment.

# Canonical Parquet store root (used when --store-dir is not given)
BNF_STORE_DIR=./store
# Execution environment label written to run_state.json
BNF_RUN_ENV=local_cli
# Global deterministic seed (used when --seed is not given)
BNF_SEED=42
# App-private lock directory (Android shared storage has no reliable flock)
BNF_LOCK_DIR=~/.bnf/locks

# omega_sim.py controls (S5 App A)
NS_C=1.10
NS_D=450
NS_BATCH=300
NS_ONLY_P4=0
NS_ONLY_P56=0
NS_WORLDS=all
