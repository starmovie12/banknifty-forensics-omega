{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bn-forensics.local/schemas/futility_certificate.schema.json",
  "title": "Futility Certificate + next_actions.yaml (FILE-021, S5 App D, K-052, K-053)",
  "schema_version": "1.0",
  "description": "The document root validates futility_certificate.yaml. $defs.next_actions validates next_actions.yaml (always >= 3 actions).",
  "$ref": "#/$defs/futility_certificate",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hunt_mode": {"type": "string", "pattern": "^H([1-9]|1[0-3])$"},
    "futility_certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "data_version", "usable_days", "search", "court_mde", "null_lab",
        "n_star", "cheapest_next_data", "ledger", "must_carry_caveats"
      ],
      "properties": {
        "schema_version": {"const": "1.0"},
        "data_version": {"$ref": "#/$defs/sha256"},
        "usable_days": {
          "type": "object",
          "additionalProperties": false,
          "required": ["playground", "court", "court_virgin", "court_exposed", "era_A", "era_B"],
          "properties": {
            "playground": {"type": "integer", "minimum": 0},
            "court": {"type": "integer", "minimum": 0},
            "court_virgin": {"type": "integer", "minimum": 0},
            "court_exposed": {"type": "integer", "minimum": 0},
            "era_A": {"type": "integer", "minimum": 0},
            "era_B": {"type": "integer", "minimum": 0}
          }
        },
        "search": {
          "type": "object",
          "additionalProperties": false,
          "required": ["m_playground", "clusters", "modes_saturated", "modes_open"],
          "properties": {
            "m_playground": {"type": "integer", "minimum": 0},
            "clusters": {"type": "integer", "minimum": 0},
            "modes_saturated": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/hunt_mode"}},
            "modes_open": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/hunt_mode"}}
          }
        },
        "court_mde": {
          "type": "object",
          "additionalProperties": false,
          "required": ["K", "alpha_k", "n_events_median", "mde_sd", "mde_atr20", "outcome_sd_atr20"],
          "properties": {
            "K": {"type": "integer", "minimum": 1, "maximum": 50},
            "alpha_k": {"type": "number", "exclusiveMinimum": 0},
            "n_events_median": {"type": "number", "minimum": 0},
            "mde_sd": {"type": "number", "exclusiveMinimum": 0},
            "mde_atr20": {"type": "number", "exclusiveMinimum": 0},
            "outcome_sd_atr20": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "null_lab": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fpr_court", "fpr_ledger", "fpr_union", "recall_at_delta"],
          "properties": {
            "fpr_court": {"type": "number", "minimum": 0, "maximum": 1},
            "fpr_ledger": {"type": "number", "minimum": 0, "maximum": 1},
            "fpr_union": {"type": "number", "minimum": 0, "maximum": 1},
            "recall_at_delta": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {"pattern": "^[0-9]+(\\.[0-9]+)?$"},
              "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        },
        "n_star": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mde_target_atr20", "mde_target_sd", "event_days_needed", "court_days_needed"],
          "properties": {
            "mde_target_atr20": {"type": "number", "exclusiveMinimum": 0},
            "mde_target_sd": {"type": "number", "exclusiveMinimum": 0},
            "event_days_needed": {"type": "integer", "minimum": 1},
            "court_days_needed": {"type": "integer", "minimum": 1}
          }
        },
        "cheapest_next_data": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ticket", "expected_n_star_reduction"],
            "properties": {
              "ticket": {"type": "string", "pattern": "^D-[0-9]{4,6}$"},
              "expected_n_star_reduction": {"type": "string", "pattern": "^([0-9]{1,3}%|n/a)$"}
            }
          }
        },
        "ledger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fwd_watch", "confirmed", "decayed", "registered_lifetime", "M", "next_tick"],
          "properties": {
            "fwd_watch": {"type": "integer", "minimum": 0},
            "confirmed": {"type": "integer", "minimum": 0},
            "decayed": {"type": "integer", "minimum": 0},
            "registered_lifetime": {"type": "integer", "minimum": 0},
            "M": {"type": "integer", "minimum": 1},
            "next_tick": {"type": "string", "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2}|PENDING-DATA)$"}
          }
        },
        "must_carry_caveats": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "contains": {"const": "Futility != no edge exists"}
        }
      }
    },
    "next_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "actions"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "actions": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type", "expected_gain", "blocked"],
            "properties": {
              "id": {"type": "string", "pattern": "^A-[0-9]{3,6}$"},
              "type": {"enum": ["HUNT", "DATA", "NULL-LAB", "WAIT"]},
              "mode": {"$ref": "#/$defs/hunt_mode"},
              "ticket": {"type": "string", "pattern": "^D-[0-9]{4,6}$"},
              "until": {"type": "string", "minLength": 1},
              "cost": {"enum": ["low", "medium", "high"]},
              "expected_gain": {"type": "string", "minLength": 1},
              "blocked": {"type": "boolean"},
              "reason": {"type": "string"}
            },
            "allOf": [
              {"if": {"properties": {"type": {"const": "HUNT"}}}, "then": {"required": ["mode"]}},
              {"if": {"properties": {"type": {"const": "DATA"}}}, "then": {"required": ["ticket"]}},
              {"if": {"properties": {"type": {"const": "WAIT"}}}, "then": {"required": ["until"]}}
            ]
          }
        }
      }
    }
  }
}
